default_platform(:android)

platform :android do
  desc "Builds signed release AAB and uploads it to the Play Store internal track"
  lane :internal do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"]
    version_code = options[:version_code] || ENV["VERSION_CODE"]
    UI.user_error!("version_name and version_code are required (tag vX.Y.Z)") unless version_name && version_code

    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "versionCode" => version_code.to_s,
        "versionName" => version_name
      }
    )

    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
