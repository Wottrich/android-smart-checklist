<?xml version="1.0" encoding="utf-8"?>
<!--
    The server-sync feature talks to a user-configured LAN server (plain HTTP,
    e.g. http://192.168.0.10:8080). Android has no dynamic per-host network security
    config, so cleartext is permitted on the base config. Drive endpoints are
    hardcoded https and unaffected by this (HTTPS is still used whenever the URL
    asks for it). TLS hardening is planned server-side.
-->
<networkSecurityConfig>
    <base-config cleartextTrafficPermitted="true" />
</networkSecurityConfig>
